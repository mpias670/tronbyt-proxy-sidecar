# Copy to .env and adjust as needed. See README.md for full documentation.

# Port the sidecar listens on inside the container.
PORT=8080

# Port exposed on your host machine (docker-compose only). If you hit
# "address already in use", change this to any free port -- no need to
# touch docker-compose.yml. Point your pixlet app's Proxy Sidecar URL at
# http://localhost:<HOST_PORT>.
HOST_PORT=8080

# Comma-separated list of hosts /fetch is allowed to reach. Requests to any
# other host are rejected with 403. This is a generic proxy, so without an
# allowlist it would be an open relay for anyone who can reach it.
ALLOWED_DOMAINS=surfline.com

# Shared secret callers must send as the X-Proxy-Token header. Leave unset
# only if the sidecar is reachable exclusively on a trusted private network.
AUTH_TOKEN=

# How long a solved Cloudflare session (cf_clearance cookie + User-Agent) is
# cached per domain before a fresh challenge solve is required.
BROWSER_CACHE_TTL_SECONDS=1500

# Hard timeout for a single on-demand headless-browser challenge solve. The
# browser process is always killed at (or before) this timeout.
BROWSER_TIMEOUT_SECONDS=25

# Hard cap on concurrent headless-browser instances. This bounds peak memory
# usage regardless of request volume; increase only if you expect multiple
# domains to need solving simultaneously and have the memory budget for it.
MAX_CONCURRENT_BROWSERS=1

# Timeout for a single upstream HTTP request on the fast (non-browser) path.
UPSTREAM_TIMEOUT_SECONDS=15

# How long a successful upstream response body is cached, keyed by the full
# target URL (e.g. one entry per spot+forecast-type). This is what actually
# stops every pixlet app render cycle from re-hitting Surfline -- surf
# conditions change slowly, so repeated requests within this window are
# served from memory. Set to 0 to disable response caching (not recommended;
# still relies on BROWSER_CACHE_TTL_SECONDS to avoid re-solving challenges,
# but every request still hits Surfline).
RESPONSE_CACHE_TTL_SECONDS=900

# Set to true to disable the headless-browser fallback entirely (fast-path
# TLS impersonation only). Useful if you cannot afford Chromium's disk/CPU
# footprint at all, at the cost of failing on domains that require a real
# JS-challenge solve.
DISABLE_BROWSER_FALLBACK=false
